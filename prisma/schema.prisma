generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DEALER
  REPRESENTATIVE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PACKED
  DELIVERED
  COMPLETED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  PARTIAL
}

enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
}

enum InventoryLogType {
  PURCHASE
  SALE
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum ChequeStatus {
  PENDING
  CLEARED
  RETURNED
}

// ---------------------------------------------------------------------------
// Representative Portal — Rep_Portal_DOCUMENTATION.md §23 / version2_changes_backend.md §1
// All enums/models below this line are additive (Rep_Portal_DOCUMENTATION.md
// v2.0 + v2.1). Nothing above this line is modified in type or meaning.
// ---------------------------------------------------------------------------

enum DealerSource {
  DEALER_PORTAL
  REP_PORTAL
}

enum CustomerStatus {
  LEAD
  NEW
  REGULAR
  VIP
  BLOCKED
  INACTIVE
}

enum BannerLinkType {
  NONE
  CATEGORY
  PRODUCT
  BRAND
  EXTERNAL_URL
}

enum RepresentativeStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum AssignmentScopeType {
  CATEGORY
  PRODUCT
  BRAND
  CAMPAIGN
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CommissionLineStatus {
  PENDING
  APPROVED
  SETTLED
  REVERSED
}

enum SettlementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  // A PAID settlement whose payout was reversed (money returned / recorded in
  // error). The original Expense stays; a SETTLEMENT_REVERSAL CashAdjustment
  // offsets it on the reversal date, and the lines go back to PENDING.
  REVERSED
}

// Liquid Cash entries that are not tied to a dealer/supplier/investor/expense
// document. OPENING_BALANCE is the verified cash on hand when record-keeping
// started (at most one active); ADJUSTMENT is a counted/bank-verified
// correction; SETTLEMENT_REVERSAL offsets a reversed commission payout.
enum CashAdjustmentType {
  OPENING_BALANCE
  ADJUSTMENT
  SETTLEMENT_REVERSAL
}

enum RefundParty {
  DEALER
  SUPPLIER
}

enum CollectionStatus {
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
}

model Admin {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String
  role             Role      @default(ADMIN)
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  purchases      Purchase[]
  activityLogs   ActivityLog[]
  approvedOrders Order[]        @relation("OrderApprovedBy")
  createdOrders  Order[]        @relation("OrderCreatedBy")
  customerNotes  CustomerNote[]

  purchaseReturnReplacements PurchaseReturnReplacement[]
  cashAdjustments            CashAdjustment[]
  refunds                    Refund[]
}

model Dealer {
  id                 String        @id @default(uuid())
  businessName       String
  ownerName          String
  phone              String
  email              String?       @unique
  address            String?
  district           String?
  username           String        @unique
  password           String
  creditLimit        Decimal       @default(0)
  unlimitedCredit    Boolean       @default(false)
  outstandingBalance Decimal       @default(0)
  status             AccountStatus @default(ACTIVE)
  resetToken         String?       @unique
  resetTokenExpiry   DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Representative Portal (Rep_Portal_DOCUMENTATION.md §23.2) — every existing
  // dealer implicitly defaults to DEALER_PORTAL; nothing about how the Admin's
  // existing Dealer screens query or display dealers changes.
  source         DealerSource    @default(DEALER_PORTAL)
  createdByRepId String?
  createdByRep   Representative? @relation("DealerCreatedByRep", fields: [createdByRepId], references: [id])

  orders                Order[]
  invoices              Invoice[]
  payments              Payment[]
  salesReturns          SalesReturn[]
  refunds               Refund[]
  customerProfile       CustomerProfile?
  notes                 CustomerNote[]
  drafts                RepOrderDraft[]
  collectionSubmissions CollectionSubmission[]

  @@index([status])
  @@index([source])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  // Homepage/catalog CMS (Rep_Portal_DOCUMENTATION.md §9) — all additive,
  // nullable/defaulted, so every existing category renders exactly as it does
  // today until an admin opts into the new fields via the CMS screens.
  imageUrl      String?
  imagePublicId String?
  iconUrl       String?
  iconPublicId  String?
  sortOrder     Int        @default(0)
  isFeatured    Boolean    @default(false)
  slug          String?    @unique
  parentId      String?
  parent        Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryParent")
}

model Product {
  id             String        @id @default(uuid())
  productCode    String        @unique
  sku            String?       @unique
  barcode        String?       @unique
  name           String
  brand          String?
  category       String?
  model          String?
  description    String?
  imageUrl       String?
  costPrice      Decimal
  wholesalePrice Decimal
  currentStock   Int           @default(0)
  warranty       String?
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Representative Portal pricing/merchandising (Rep_Portal_DOCUMENTATION.md
  // §23.5) — retailPrice falls back to wholesalePrice when unset; every
  // existing dealer/admin price read is unaffected, both read wholesalePrice
  // exactly as before.
  retailPrice    Decimal?
  compareAtPrice Decimal?
  isFeatured     Boolean  @default(false)

  orderItems                     OrderItem[]
  purchaseItems                  PurchaseItem[]
  purchaseReturnReplacementItems PurchaseReturnReplacementItem[]
  inventoryLogs                  InventoryLog[]
  salesReturnItems               SalesReturnItem[]
  purchaseReturnItems            PurchaseReturnItem[]
  images                         ProductImage[]
  commissionRules                CommissionRule[]
  commissionLedgerEntries        CommissionLedgerEntry[]
  availabilityOverride           ProductAvailabilityOverride?
  draftItems                     RepOrderDraftItem[]

  @@index([category])
  @@index([status])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Supplier {
  id      String  @id @default(uuid())
  name    String
  contact String?
  phone   String?
  email   String?
  address String?

  purchases        Purchase[]
  supplierPayments SupplierPayment[]
  purchaseReturns  PurchaseReturn[]
  refunds          Refund[]

  purchaseReturnReplacements PurchaseReturnReplacement[]
}

model Purchase {
  id               String    @id @default(uuid())
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id])
  invoiceNumber    String
  purchaseDate     DateTime
  totalValue       Decimal
  transportCharges Decimal   @default(0)
  adminId          String
  admin            Admin     @relation(fields: [adminId], references: [id])
  createdAt        DateTime  @default(now())
  // Set when the order was called off. Cancelling returns every unit still
  // held through a PurchaseReturn flagged isCancellation, so the supplier's
  // payable drops by the same value; reinstating removes that return again.
  cancelledAt      DateTime?
  cancelReason     String?

  items           PurchaseItem[]
  purchaseReturns PurchaseReturn[]
  // Supplier refunds of money paid toward this order (e.g. an advance on a
  // cancelled order). Informational link — the balance is per supplier.
  refunds         Refund[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseReturn {
  id             String                      @id @default(uuid())
  returnNumber   String                      @unique
  purchaseId     String?
  purchase       Purchase?                   @relation(fields: [purchaseId], references: [id])
  supplierId     String
  supplier       Supplier                    @relation(fields: [supplierId], references: [id])
  reason         String
  totalAmount    Decimal
  returnDate     DateTime
  createdAt      DateTime                    @default(now())
  // The return created by cancelling its purchase. Only reinstating that
  // purchase removes it; it can't be edited or deleted on its own.
  isCancellation Boolean                     @default(false)
  items          PurchaseReturnItem[]
  replacements   PurchaseReturnReplacement[]

  @@index([purchaseId])
  @@index([supplierId])
  @@index([returnDate])
}

model PurchaseReturnItem {
  id               String         @id @default(uuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Int
  unitCost         Decimal
  lineTotal        Decimal

  replacementItems PurchaseReturnReplacementItem[]

  @@index([purchaseReturnId])
  @@index([productId])
}

// Goods a supplier sent in place of returned ones. The tables were created by
// migration 20260929120000_purchase_return_replacements (feature branch
// feature/return-replacement-receipts) and already hold data in deployed
// databases; these models only describe them — no migration is needed. A
// replacement reverses the payable credit its return took off.
model PurchaseReturnReplacement {
  id                String         @id @default(uuid())
  replacementNumber String         @unique
  idempotencyKey    String         @unique
  purchaseReturnId  String
  purchaseReturn    PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Restrict)
  supplierId        String
  supplier          Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  totalAmount       Decimal
  receivedDate      DateTime
  reference         String?
  notes             String?
  adminId           String
  admin             Admin          @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now())

  items PurchaseReturnReplacementItem[]

  @@index([purchaseReturnId])
  @@index([supplierId])
  @@index([receivedDate])
}

model PurchaseReturnReplacementItem {
  id                   String                    @id @default(uuid())
  replacementId        String
  replacement          PurchaseReturnReplacement @relation(fields: [replacementId], references: [id], onDelete: Restrict)
  purchaseReturnItemId String
  purchaseReturnItem   PurchaseReturnItem        @relation(fields: [purchaseReturnItemId], references: [id], onDelete: Restrict)
  productId            String
  product              Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity             Int
  unitCost             Decimal
  lineTotal            Decimal

  @@index([replacementId])
  @@index([purchaseReturnItemId])
  @@index([productId])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal
  lineTotal  Decimal

  @@index([purchaseId])
  @@index([productId])
}

model InventoryLog {
  id           String           @id @default(uuid())
  productId    String
  product      Product          @relation(fields: [productId], references: [id])
  type         InventoryLogType
  quantityIn   Int              @default(0)
  quantityOut  Int              @default(0)
  balanceAfter Int
  reference    String?
  createdAt    DateTime         @default(now())

  @@index([productId])
  @@index([type])
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  dealerId     String
  dealer       Dealer      @relation(fields: [dealerId], references: [id])
  status       OrderStatus @default(PENDING_APPROVAL)
  subtotal     Decimal
  discount     Decimal     @default(0)
  totalAmount  Decimal
  rejectReason String?

  approvedByAdminId String?
  approvedByAdmin   Admin?    @relation("OrderApprovedBy", fields: [approvedByAdminId], references: [id])
  approvedAt        DateTime?
  rejectedAt        DateTime?
  packedAt          DateTime?
  deliveredAt       DateTime?
  completedAt       DateTime?

  // Set only when an admin records this order directly (e.g. a walk-in sale)
  // rather than a dealer submitting it for approval — distinguishes the two
  // so only admin-recorded orders can be edited after the fact.
  createdByAdminId String?
  createdByAdmin   Admin?  @relation("OrderCreatedBy", fields: [createdByAdminId], references: [id])

  // Representative Portal (Rep_Portal_DOCUMENTATION.md §23.7 / §16) — set only
  // when a representative placed this order on a shop's behalf. notes/
  // expectedDeliveryDate are generically-useful additive fields, not
  // rep-exclusive; every existing order simply has them null.
  createdByRepId       String?
  createdByRep         Representative? @relation("OrderCreatedByRep", fields: [createdByRepId], references: [id])
  notes                String?
  expectedDeliveryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items               OrderItem[]
  invoice             Invoice?
  salesReturns        SalesReturn[]
  commissionEntries   CommissionLedgerEntry[]
  collectionReminders CollectionReminderLog[]

  @@index([dealerId])
  @@index([status])
  @@index([createdByRepId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal
  lineTotal Decimal

  // This line's share of the order's total discount, allocated proportionally
  // by lineTotal share once the order is finalized (approved/completed) —
  // never recomputed after. Returns always refund from netUnitPrice, since
  // the customer never actually paid the pre-discount unitPrice.
  allocatedDiscount Decimal @default(0)
  netLineTotal      Decimal
  netUnitPrice      Decimal

  @@index([orderId])
  @@index([productId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  dealerId      String
  dealer        Dealer        @relation(fields: [dealerId], references: [id])
  subtotal      Decimal
  discountTotal Decimal       @default(0)
  grandTotal    Decimal
  paymentStatus PaymentStatus @default(PENDING)
  dueDate       DateTime?
  createdAt     DateTime      @default(now())

  payments              Payment[]
  collectionSubmissions CollectionSubmission[]

  @@index([dealerId])
  @@index([paymentStatus])
}

model Payment {
  id          String      @id @default(uuid())
  // Null means this isn't a payment against any specific invoice — it's a
  // standalone credit added directly to the dealer's account (e.g. an
  // advance/prepayment). Everything else about it (mode, cheque lifecycle,
  // edit/reverse window, activity log) works exactly like a normal payment;
  // only the invoice-balance cap and paymentStatus recompute don't apply.
  invoiceId   String?
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  dealerId    String
  dealer      Dealer      @relation(fields: [dealerId], references: [id])
  amount      Decimal
  mode        PaymentMode
  reference   String?
  paymentDate DateTime
  createdAt   DateTime    @default(now())

  // Cheque-specific fields, set when mode = CHEQUE. The dealer's outstanding
  // balance and the invoice's paymentStatus are updated as soon as the cheque
  // is recorded (PENDING) — money isn't counted in Liquid Cash until it
  // actually CLEARS, and if it's marked RETURNED the balance/status effects
  // of this payment are reversed.
  chequeStatus          ChequeStatus?
  chequeStatusUpdatedAt DateTime?
  bankName              String?
  chequeNumber          String?
  chequeDate            DateTime?
  collectedDate         DateTime?
  remarks               String?

  collectionSubmission CollectionSubmission?

  @@index([invoiceId])
  @@index([dealerId])
  @@index([paymentDate])
  @@index([chequeStatusUpdatedAt])
}

// Undo history for admin corrections on the Payments screen. Every edit,
// cheque-status change and delete stores the full payment row as it was
// *before* the change, so it can be put back exactly — a deleted payment is
// restored from here with its original id and createdAt. Deliberately no FK
// to Payment: the row being described may currently not exist (deleted).
model PaymentRevision {
  id        String    @id @default(uuid())
  paymentId String
  invoiceId String?
  // UPDATED | CHEQUE_STATUS | DELETED
  action    String
  snapshot  Json
  adminId   String
  createdAt DateTime  @default(now())
  // Set once this change has been undone — it then drops out of the undo stack.
  undoneAt  DateTime?

  @@index([paymentId, createdAt])
  @@index([action, undoneAt])
  @@index([invoiceId])
}

model SupplierPayment {
  id                    String        @id @default(uuid())
  supplierId            String
  supplier              Supplier      @relation(fields: [supplierId], references: [id])
  amount                Decimal
  mode                  PaymentMode
  reference             String?
  paymentDate           DateTime
  chequeStatus          ChequeStatus?
  chequeStatusUpdatedAt DateTime?
  chequeDepositDate     DateTime?
  chequeReminderSentAt  DateTime?
  remarks               String?
  createdAt             DateTime      @default(now())

  @@index([supplierId])
  @@index([paymentDate])
  @@index([chequeStatusUpdatedAt])
}

model Investor {
  id                    String   @id @default(uuid())
  name                  String
  phone                 String?
  email                 String?
  profitSharePercentage Decimal  @default(0)
  createdAt             DateTime @default(now())

  investments Investment[]
}

model Investment {
  id             String      @id @default(uuid())
  investorId     String
  investor       Investor    @relation(fields: [investorId], references: [id])
  amount         Decimal
  mode           PaymentMode
  investmentDate DateTime
  reason         String
  remarks        String?
  createdAt      DateTime    @default(now())

  // Cheque lifecycle, same rules as dealer payments: a cheque investment adds
  // to Liquid Cash only once CLEARED (dated by chequeStatusUpdatedAt). Null on
  // every row recorded before this existed — those keep counting as before.
  chequeStatus          ChequeStatus?
  chequeStatusUpdatedAt DateTime?
  chequeNumber          String?
  bankName              String?
  chequeDate            DateTime?

  @@index([investorId])
  @@index([investmentDate])
  @@index([chequeStatusUpdatedAt])
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  expenseDate DateTime
  remarks     String?
  createdAt   DateTime @default(now())

  representativeSettlement RepresentativeSettlement?

  @@index([expenseDate])
}

model SalesReturn {
  id           String   @id @default(uuid())
  returnNumber String   @unique
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  dealerId     String
  dealer       Dealer   @relation(fields: [dealerId], references: [id])
  reason       String
  totalAmount  Decimal
  returnDate   DateTime
  createdAt    DateTime @default(now())

  items SalesReturnItem[]

  @@index([orderId])
  @@index([dealerId])
}

model SalesReturnItem {
  id                String      @id @default(uuid())
  salesReturnId     String
  salesReturn       SalesReturn @relation(fields: [salesReturnId], references: [id])
  productId         String
  product           Product     @relation(fields: [productId], references: [id])
  quantity          Int
  // The order item's original (pre-discount) unit price — kept for display
  // only. lineTotal (the actual refund) is always computed from the order
  // item's netUnitPrice, never from this.
  unitPrice         Decimal
  // This return line's share of the discount the customer already received
  // on these units — informational, mirrors OrderItem.allocatedDiscount.
  allocatedDiscount Decimal     @default(0)
  lineTotal         Decimal

  @@index([salesReturnId])
  @@index([productId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  action    String
  targetId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  role      Role
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Representative — Rep_Portal_DOCUMENTATION.md §23.4, revised per
// version2_changes_backend.md §3.3/§4/§5 (dedicated RepresentativeStatus
// enum, email-as-username, onboarding/lockout fields). Mirrors Admin/Dealer's
// existing auth shape — same bcrypt/resetToken/RefreshToken pattern, nothing
// new invented.
// ---------------------------------------------------------------------------

model Representative {
  id                  String               @id @default(uuid())
  name                String
  phone               String
  email               String               @unique
  username            String               @unique
  password            String
  nicOrEmployeeId     String?              @unique
  address             String?
  joiningDate         DateTime?
  status              RepresentativeStatus @default(ACTIVE)
  mustChangePassword  Boolean              @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  resetToken          String?              @unique
  resetTokenExpiry    DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  customersCreated      Dealer[]                     @relation("DealerCreatedByRep")
  customersAssigned     CustomerProfile[]            @relation("CustomerAssignedRep")
  ordersCreated         Order[]                      @relation("OrderCreatedByRep")
  notes                 CustomerNote[]
  loginHistory          RepresentativeLoginHistory[]
  activityLog           RepresentativeActivityLog[]
  productAssignments    ProductAssignment[]
  bannerAssignments     BannerAssignment[]
  commissionLedger      CommissionLedgerEntry[]
  settlements           RepresentativeSettlement[]
  collectionSubmissions CollectionSubmission[]
  draftsCreated         RepOrderDraft[]

  @@index([status])
}

model RepresentativeLoginHistory {
  id               String         @id @default(uuid())
  representativeId String
  representative   Representative @relation(fields: [representativeId], references: [id])
  loginAt          DateTime       @default(now())
  ipAddress        String?
  userAgent        String?
  success          Boolean
  failureReason    String?

  @@index([representativeId])
}

// Dedicated, richer audit trail for representatives (IP/device) — deliberately
// separate from the shared, admin-scoped ActivityLog above rather than
// extending it, so this table's extra columns never apply to admin-authored
// rows (version2_changes_backend.md §13.3). ActivityLog itself is untouched.
model RepresentativeActivityLog {
  id               String         @id @default(uuid())
  representativeId String
  representative   Representative @relation(fields: [representativeId], references: [id])
  action           String
  targetId         String?
  details          String?
  ipAddress        String?
  userAgent        String?
  deviceType       String?
  createdAt        DateTime       @default(now())

  @@index([representativeId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Customer satellite — Rep_Portal_DOCUMENTATION.md §23.3. A 1:1 extension of
// Dealer for rep-managed CRM data, kept off the transactional Dealer table
// itself (see that document's §23.3 for the full "why a satellite table"
// reasoning).
// ---------------------------------------------------------------------------

model CustomerProfile {
  dealerId String @id
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  whatsapp          String?
  city              String?
  province          String?
  area              String?
  latitude          Float?
  longitude         Float?
  shopPhotoUrl      String?
  shopPhotoPublicId String?

  status        CustomerStatus  @default(NEW)
  assignedRepId String?
  assignedRep   Representative? @relation("CustomerAssignedRep", fields: [assignedRepId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedRepId])
}

model CustomerNote {
  id            String          @id @default(uuid())
  dealerId      String
  dealer        Dealer          @relation(fields: [dealerId], references: [id])
  authorRepId   String?
  authorRep     Representative? @relation(fields: [authorRepId], references: [id])
  authorAdminId String?
  authorAdmin   Admin?          @relation(fields: [authorAdminId], references: [id])
  note          String
  createdAt     DateTime        @default(now())

  @@index([dealerId])
}

// ---------------------------------------------------------------------------
// Product & banner assignment, inventory visibility — version2_changes_backend.md §6-§8
// ---------------------------------------------------------------------------

model ProductAssignment {
  id               String              @id @default(uuid())
  representativeId String
  representative   Representative      @relation(fields: [representativeId], references: [id])
  scopeType        AssignmentScopeType
  // productId / category name / brand name / campaign key, depending on
  // scopeType — denormalized on purpose, mirroring the existing
  // Product.category / Product.brand text-field convention.
  scopeValue       String
  createdAt        DateTime            @default(now())

  @@unique([representativeId, scopeType, scopeValue])
  @@index([representativeId])
}

model BannerAssignment {
  id               String         @id @default(uuid())
  representativeId String
  representative   Representative @relation(fields: [representativeId], references: [id])
  bannerId         String
  banner           Banner         @relation(fields: [bannerId], references: [id])
  priority         Int            @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())

  @@unique([representativeId, bannerId])
  @@index([representativeId])
}

model ProductAvailabilityOverride {
  productId      String   @id
  product        Product  @relation(fields: [productId], references: [id])
  // true  = show "In Stock" to reps even if currentStock <= 0
  // false = show "Out of Stock" to reps even if currentStock > 0
  // absent (no row) = fall back to the real currentStock > 0 check
  forceAvailable Boolean
  reason         String?
  setByAdminId   String
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Commission engine — version2_changes_backend.md §9-§12. Computed entirely
// outside the Order approval pipeline (see that document's §2) — no table
// here is ever written to by OrdersService.
// ---------------------------------------------------------------------------

model CommissionRule {
  id               String         @id @default(uuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  type             CommissionType
  // Percentage (0-100) or a fixed currency amount, depending on `type`.
  value            Decimal
  startDate        DateTime
  endDate          DateTime?
  isCampaign       Boolean        @default(false)
  campaignName     String?
  createdByAdminId String
  createdAt        DateTime       @default(now())

  ledgerEntries CommissionLedgerEntry[]

  @@index([productId])
  @@index([startDate, endDate])
}

model CommissionLedgerEntry {
  id               String                    @id @default(uuid())
  representativeId String
  representative   Representative            @relation(fields: [representativeId], references: [id])
  orderId          String
  order            Order                     @relation(fields: [orderId], references: [id])
  orderItemId      String
  productId        String
  product          Product                   @relation(fields: [productId], references: [id])
  commissionRuleId String?
  commissionRule   CommissionRule?           @relation(fields: [commissionRuleId], references: [id])
  amount           Decimal
  status           CommissionLineStatus      @default(PENDING)
  settlementId     String?
  settlement       RepresentativeSettlement? @relation(fields: [settlementId], references: [id])
  createdAt        DateTime                  @default(now())

  @@index([representativeId])
  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Settlements — the payout, and its one and only bridge into accounting.
// version2_changes_backend.md §13-§14: expenseId points at a real Expense row
// created through the exact same tx.expense.create() ExpensesService already
// uses — no parallel accounting path.
// ---------------------------------------------------------------------------

model RepresentativeSettlement {
  id                String           @id @default(uuid())
  settlementNumber  String           @unique
  representativeId  String
  representative    Representative   @relation(fields: [representativeId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  totalCommission   Decimal
  status            SettlementStatus @default(PENDING)
  mode              PaymentMode?
  chequeStatus      ChequeStatus?
  chequeNumber      String?
  bankName          String?
  chequeDate        DateTime?
  expenseId         String?          @unique
  expense           Expense?         @relation(fields: [expenseId], references: [id])
  approvedByAdminId String?
  approvedAt        DateTime?
  rejectedReason    String?
  paidAt            DateTime?
  // Cash/bank-transfer reference given when paying.
  reference         String?
  reversedAt        DateTime?
  reversalReason    String?
  createdAt         DateTime         @default(now())

  lines          CommissionLedgerEntry[]
  cashAdjustment CashAdjustment?
}

// ---------------------------------------------------------------------------
// Liquid Cash integrity (docs/LIQUID_CASH_ACCOUNTING_CONTRACT.md)
// ---------------------------------------------------------------------------

model CashAdjustment {
  id                String                    @id @default(uuid())
  adjustmentNumber  String                    @unique
  type              CashAdjustmentType
  // Signed: positive adds to Liquid Cash, negative takes from it.
  amount            Decimal
  adjustmentDate    DateTime
  reason            String
  // Cash-count sheet, bank statement or other evidence the figure came from.
  evidenceReference String?
  adminId           String
  admin             Admin                     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  // Set on a row that exactly negates an earlier adjustment. Adjustments are
  // never edited or deleted — a mistake is corrected by reversing it.
  reversalOfId      String?                   @unique
  reversalOf        CashAdjustment?           @relation("CashAdjustmentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy        CashAdjustment?           @relation("CashAdjustmentReversal")
  settlementId      String?                   @unique
  settlement        RepresentativeSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  createdAt         DateTime                  @default(now())

  @@index([adjustmentDate])
  @@index([type])
}

// Money returned to a dealer (cash out) or received back from a supplier
// (cash in) when they hold a credit — e.g. a sales return on a paid invoice.
// Cheque refunds move Liquid Cash only once CLEARED, like payments.
model Refund {
  id                    String        @id @default(uuid())
  refundNumber          String        @unique
  party                 RefundParty
  dealerId              String?
  dealer                Dealer?       @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  supplierId            String?
  supplier              Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  // Supplier refunds only: the order the money was paid toward, if any.
  purchaseId            String?
  purchase              Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  amount                Decimal
  mode                  PaymentMode
  refundDate            DateTime
  reference             String?
  reason                String
  chequeStatus          ChequeStatus?
  chequeStatusUpdatedAt DateTime?
  chequeNumber          String?
  bankName              String?
  chequeDate            DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  adminId               String
  admin                 Admin         @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt             DateTime      @default(now())

  @@index([dealerId])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([refundDate])
  @@index([chequeStatusUpdatedAt])
}

// Before-images of changes to cash-moving records other than dealer payments
// (those use PaymentRevision). Liquid Cash history replays them as dated
// correction rows instead of silently re-dating the original entry.
model LedgerRevision {
  id         String   @id @default(uuid())
  // SUPPLIER_PAYMENT | INVESTMENT | EXPENSE | REFUND
  entityType String
  entityId   String
  // UPDATED | CHEQUE_STATUS | DELETED | CANCELLED
  action     String
  snapshot   Json
  adminId    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// ---------------------------------------------------------------------------
// Collections — a staging inbox, never a direct financial write.
// version2_changes_backend.md §14: resultingPaymentId is only ever set after
// an admin confirms, via the existing, unmodified PaymentsService.create().
// ---------------------------------------------------------------------------

model CollectionSubmission {
  id                 String           @id @default(uuid())
  representativeId   String
  representative     Representative   @relation(fields: [representativeId], references: [id])
  customerId         String
  customer           Dealer           @relation(fields: [customerId], references: [id])
  invoiceId          String?
  invoice            Invoice?         @relation(fields: [invoiceId], references: [id])
  amount             Decimal
  mode               PaymentMode
  chequeNumber       String?
  bankName           String?
  chequeDate         DateTime?
  collectionDate     DateTime
  notes              String?
  chequeImageUrl     String?
  status             CollectionStatus @default(PENDING_VERIFICATION)
  verifiedByAdminId  String?
  verifiedAt         DateTime?
  rejectedReason     String?
  resultingPaymentId String?          @unique
  resultingPayment   Payment?         @relation(fields: [resultingPaymentId], references: [id])
  createdAt          DateTime         @default(now())

  @@index([representativeId])
  @@index([customerId])
  @@index([status])
}

model CollectionReminderLog {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  sentAt      DateTime @default(now())
  daysOverdue Int

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Brand — mirrors the existing Category pattern exactly (Rep_Portal_DOCUMENTATION.md
// §8.1). Product.brand stays a denormalized free-text string, never an FK, for
// the same "reuse a proven additive pattern" reasoning already applied to Category.
// ---------------------------------------------------------------------------

model Brand {
  id            String        @id @default(uuid())
  name          String        @unique
  logoUrl       String?
  logoPublicId  String?
  imageUrl      String?
  imagePublicId String?
  description   String?
  status        AccountStatus @default(ACTIVE)
  sortOrder     Int           @default(0)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Banner — homepage CMS, Rep_Portal_DOCUMENTATION.md §10/§4.1.
// ---------------------------------------------------------------------------

model Banner {
  id        String         @id @default(uuid())
  imageUrl  String
  publicId  String
  title     String?
  subtitle  String?
  ctaLabel  String?
  linkType  BannerLinkType @default(NONE)
  linkValue String?
  sortOrder Int            @default(0)
  status    AccountStatus  @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  assignments BannerAssignment[]
}

// ---------------------------------------------------------------------------
// RepOrderDraft — the server-side cart, Rep_Portal_DOCUMENTATION.md §14/§23.9.
// Deliberately not an Order row and has no interaction with OrderStatus,
// stock reservation, or credit checks until explicitly submitted — see that
// document's §14.2 for why.
// ---------------------------------------------------------------------------

model RepOrderDraft {
  id                   String         @id @default(uuid())
  repId                String
  representative       Representative @relation(fields: [repId], references: [id])
  dealerId             String?
  dealer               Dealer?        @relation(fields: [dealerId], references: [id])
  notes                String?
  expectedDeliveryDate DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  items RepOrderDraftItem[]

  @@index([repId])
}

model RepOrderDraftItem {
  id        String        @id @default(uuid())
  draftId   String
  draft     RepOrderDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int

  @@index([draftId])
}
