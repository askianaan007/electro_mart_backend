{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.(int|e2e)-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/support/global-setup.ts",
  "setupFiles": ["<rootDir>/support/setup-env.ts"],
  "maxWorkers": 1,
  "testTimeout": 60000
}
